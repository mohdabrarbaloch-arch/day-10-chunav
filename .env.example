# ---------------------------------------------------------------------------
# Chunav — environment configuration
# Copy to .env and adjust. Every value below has a working development default,
# so the app runs on a fresh clone with no .env at all.
# ---------------------------------------------------------------------------

# development | production
# In production the app refuses to start unless SECRET_KEY is strong,
# DATABASE_URL is PostgreSQL, and CORS_ORIGINS lists explicit origins.
ENVIRONMENT=development

# Signing key for JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be at least 32 characters in production. Never commit a real value.
SECRET_KEY=dev-only-insecure-key

# How long an access token stays valid, in minutes. Default 12 hours.
ACCESS_TOKEN_MINUTES=720

# SQLAlchemy URL.
#   SQLite (default, zero setup):  sqlite:///./chunav.db
#   PostgreSQL:                    postgresql+psycopg://chunav:chunav@localhost:5432/chunav
# docker-compose sets this automatically.
DATABASE_URL=sqlite:///./chunav.db

# Largest CSV accepted, in bytes. Default 5 MB.
MAX_UPLOAD_BYTES=5000000

# Hard cap on rows read from a CSV. Default 20000.
MAX_ROWS=20000

# Default number of cross-validation folds (2-10).
DEFAULT_FOLDS=5

# How many candidates from the pool a run trains by default (1-20).
MAX_CANDIDATES=8

# Advisory budget for a single search, in seconds. Not enforced — see
# docs/setup.md "Known limits".
SEARCH_TIMEOUT_SECONDS=120

# Comma-separated allowed origins. "*" is fine in development and rejected
# in production.
CORS_ORIGINS=*

# Requests per minute per client IP. In-process only: with N workers the
# effective limit is N times this value.
RATE_LIMIT_PER_MINUTE=120
